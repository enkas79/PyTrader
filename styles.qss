/* Tema scuro PyTrader — griglia 4/8 px, contrasto WCAG AA.
   Testo #e6e9ef su #1c1f26 = 13.9:1; testo bianco su #2f6fd6 = 4.9:1; #9aa3b2 su #1c1f26 = 6.9:1 */

QWidget {
    background-color: #1c1f26;
    color: #e6e9ef;
    font-size: 13px;
}

QMainWindow::separator, QSplitter::handle {
    background-color: #2a2f3a;
    width: 4px;
    height: 4px;
}

QMenuBar {
    background-color: #16181d;
    padding: 4px 8px;
}
QMenuBar::item {
    padding: 4px 12px;
    border-radius: 4px;
}
QMenuBar::item:selected, QMenu::item:selected {
    background-color: #2f6fd6;
    color: #ffffff;
}
QMenu {
    background-color: #232730;
    border: 1px solid #353b48;
    padding: 4px;
}
QMenu::item {
    padding: 8px 24px 8px 16px;
    border-radius: 4px;
}
QMenu::separator {
    height: 1px;
    background: #353b48;
    margin: 4px 8px;
}

QScrollArea, #sidePanel {
    background-color: #1c1f26;
    border: none;
}

QGroupBox {
    background-color: #232730;
    border: 1px solid #2f3440;
    border-radius: 8px;
    margin-top: 16px;
    padding: 16px 12px 12px 12px;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 4px;
    color: #9aa3b2;
    background-color: transparent;
}
QGroupBox QLabel {
    background-color: transparent;
    font-weight: 400;
    color: #c9ced6;
}

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QPlainTextEdit, QTextBrowser {
    background-color: #16181d;
    border: 1px solid #353b48;
    border-radius: 4px;
    padding: 4px 8px;
    min-height: 24px;
    selection-background-color: #2f6fd6;
    selection-color: #ffffff;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QPlainTextEdit:focus {
    border: 1px solid #5b8def;
}
QComboBox QAbstractItemView {
    background-color: #232730;
    border: 1px solid #353b48;
    selection-background-color: #2f6fd6;
}

QPushButton {
    background-color: #2f6fd6;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 8px 16px;
    font-weight: 600;
    min-height: 16px;
}
QPushButton:hover {
    background-color: #3b7be6;
}
QPushButton:pressed {
    background-color: #255bb3;
}
QPushButton:disabled {
    background-color: #2a2f3a;
    color: #7c8594;
}
QPushButton#secondaryButton {
    background-color: #2a2f3a;
    color: #e6e9ef;
    padding: 4px 8px;
}
QPushButton#secondaryButton:hover {
    background-color: #353b48;
}

QTabWidget::pane {
    border: 1px solid #2f3440;
    border-radius: 4px;
    top: -1px;
}
QTabBar::tab {
    background-color: #1c1f26;
    color: #9aa3b2;
    padding: 8px 16px;
    border-bottom: 2px solid transparent;
}
QTabBar::tab:selected {
    color: #e6e9ef;
    border-bottom: 2px solid #5b8def;
}
QTabBar::tab:hover {
    color: #e6e9ef;
}

QTableWidget {
    background-color: #1c1f26;
    alternate-background-color: #20242c;
    gridline-color: #2a2f3a;
    border: none;
    selection-background-color: #2f6fd6;
    selection-color: #ffffff;
}
QHeaderView::section {
    background-color: #232730;
    color: #9aa3b2;
    border: none;
    border-bottom: 1px solid #353b48;
    padding: 8px;
    font-weight: 600;
}

QLabel#metricValue {
    font-size: 16px;
    font-weight: 600;
    background-color: transparent;
}
QLabel#hint {
    color: #9aa3b2;
    background-color: transparent;
}

QStatusBar {
    background-color: #16181d;
    color: #9aa3b2;
    padding: 4px 8px;
}

QScrollBar:vertical, QScrollBar:horizontal {
    background: #1c1f26;
    width: 12px;
    height: 12px;
    margin: 0;
}
QScrollBar::handle {
    background: #353b48;
    border-radius: 4px;
    min-height: 24px;
    min-width: 24px;
}
QScrollBar::handle:hover {
    background: #4a5162;
}
QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
    width: 0;
    height: 0;
}

QProgressBar {
    background-color: #16181d;
    border: 1px solid #353b48;
    border-radius: 4px;
    text-align: center;
}
QProgressBar::chunk {
    background-color: #2f6fd6;
    border-radius: 4px;
}

QToolTip {
    background-color: #232730;
    color: #e6e9ef;
    border: 1px solid #353b48;
    padding: 4px 8px;
}
