/* Foglio di stile PyTrader — modello comune ai temi chiaro e scuro.
   I segnaposto dei colori sono sostituiti dalla palette (src/pytrader/gui/theme.py).
   Griglia 4/8 px; contrasto WCAG AA verificato dai test (tests/test_theme.py). */

QWidget {
    background-color: @window;
    color: @text;
    font-size: 13px;
}

QMainWindow::separator, QSplitter::handle {
    background-color: @separator;
    width: 4px;
    height: 4px;
}

QMenuBar {
    background-color: @menubar;
    padding: 4px 8px;
}
QMenuBar::item {
    padding: 4px 12px;
    border-radius: 4px;
}
QMenuBar::item:selected, QMenu::item:selected {
    background-color: @accent;
    color: @accent_text;
}
QMenu {
    background-color: @surface;
    border: 1px solid @border;
    padding: 4px;
}
QMenu::item {
    padding: 8px 24px 8px 16px;
    border-radius: 4px;
}
QMenu::separator {
    height: 1px;
    background: @border;
    margin: 4px 8px;
}

QScrollArea, #sidePanel {
    background-color: @window;
    border: none;
}

QGroupBox {
    background-color: @surface;
    border: 1px solid @border_soft;
    border-radius: 8px;
    margin-top: 16px;
    padding: 12px 8px 8px 8px;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 4px;
    color: @text_muted;
    background-color: transparent;
}
QGroupBox QLabel, QGroupBox QCheckBox {
    background-color: transparent;
    font-weight: 400;
    color: @text_label;
}

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QPlainTextEdit, QTextBrowser {
    background-color: @input;
    border: 1px solid @border;
    border-radius: 4px;
    padding: 4px 8px;
    min-height: 24px;
    selection-background-color: @accent;
    selection-color: @accent_text;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QPlainTextEdit:focus {
    border: 1px solid @focus;
}
QComboBox QAbstractItemView {
    background-color: @surface;
    border: 1px solid @border;
    selection-background-color: @accent;
}

QCheckBox {
    spacing: 8px;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid @border;
    border-radius: 4px;
    background-color: @input;
}
QCheckBox::indicator:checked {
    background-color: @accent;
    border-color: @accent;
}
QCheckBox::indicator:focus, QCheckBox::indicator:hover {
    border-color: @focus;
}

QPushButton {
    background-color: @accent;
    color: @accent_text;
    border: none;
    border-radius: 4px;
    padding: 8px 16px;
    font-weight: 600;
    min-height: 16px;
}
QPushButton:hover {
    background-color: @accent_hover;
}
QPushButton:pressed {
    background-color: @accent_pressed;
}
QPushButton:disabled {
    background-color: @disabled_bg;
    color: @disabled_text;
}
QPushButton#secondaryButton {
    background-color: @secondary;
    color: @text;
    padding: 8px 12px;
}
QPushButton#iconButton {
    background-color: @secondary;
    color: @text;
    padding: 4px;
}
QPushButton#iconButton:hover {
    background-color: @secondary_hover;
}
QPushButton#secondaryButton:hover {
    background-color: @secondary_hover;
}

QTabWidget::pane {
    border: 1px solid @border_soft;
    border-radius: 4px;
    top: -1px;
}
QTabBar::tab {
    background-color: @window;
    color: @text_muted;
    padding: 8px 16px;
    border-bottom: 2px solid transparent;
}
QTabBar::tab:selected {
    color: @text;
    border-bottom: 2px solid @focus;
}
QTabBar::tab:hover {
    color: @text;
}

QTableWidget {
    background-color: @window;
    alternate-background-color: @table_alt;
    gridline-color: @separator;
    border: none;
    selection-background-color: @accent;
    selection-color: @accent_text;
}
QHeaderView::section {
    background-color: @surface;
    color: @text_muted;
    border: none;
    border-bottom: 1px solid @border;
    padding: 8px;
    font-weight: 600;
}

QLabel#metricValue {
    font-size: 15px;
    font-weight: 600;
    background-color: transparent;
}
QLabel#metricValue[tone="up"] {
    color: @up;
}
QLabel#metricValue[tone="down"] {
    color: @down;
}
QLabel#metricCaption {
    color: @text_muted;
    font-size: 12px;
    font-weight: 400;
    background-color: transparent;
}
QLabel#inlineLabel {
    color: @text_label;
    background-color: transparent;
    font-weight: 400;
}
QFrame#metricCard {
    background-color: @window;
    border: 1px solid @border_soft;
    border-radius: 4px;
}
QLabel#paramsSummary {
    color: @text_label;
    background-color: transparent;
    font-weight: 400;
}
QLabel#paramsSummary:hover {
    color: @focus;
}
QToolBar {
    background-color: @menubar;
    border: none;
    border-bottom: 1px solid @separator;
    padding: 0 8px 4px 8px;
    spacing: 4px;
}
QToolBar::separator {
    background-color: @border;
    width: 1px;
    margin: 4px 8px;
}
QToolButton {
    background-color: transparent;
    color: @text;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px 12px;
    font-weight: 600;
}
QToolButton:hover {
    background-color: @secondary;
    border-color: @border;
}
QToolButton:checked {
    background-color: @secondary_hover;
    border-color: @focus;
}
QToolButton:disabled {
    color: @disabled_text;
}
QToolButton[attention="true"], QPushButton[attention="true"] {
    background-color: @accent;
    color: @accent_text;
    border: 2px solid @focus;
}

QDockWidget {
    color: @text_muted;
    font-weight: 600;
}
QDockWidget::title {
    background-color: @surface;
    border-bottom: 1px solid @border_soft;
    padding: 8px;
}
#paramsPanel, #paramsPanel QScrollArea {
    background-color: @window;
}
QLabel#hint {
    color: @text_muted;
    background-color: transparent;
}

QStatusBar {
    background-color: @menubar;
    color: @text_muted;
    padding: 4px 8px;
}

QScrollBar:vertical, QScrollBar:horizontal {
    background: @window;
    width: 12px;
    height: 12px;
    margin: 0;
}
QScrollBar::handle {
    background: @scroll_handle;
    border-radius: 4px;
    min-height: 24px;
    min-width: 24px;
}
QScrollBar::handle:hover {
    background: @scroll_hover;
}
QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
    width: 0;
    height: 0;
}

QProgressBar {
    background-color: @input;
    border: 1px solid @border;
    border-radius: 4px;
    text-align: center;
}
QProgressBar::chunk {
    background-color: @accent;
    border-radius: 4px;
}

QToolTip {
    background-color: @surface;
    color: @text;
    border: 1px solid @border;
    padding: 4px 8px;
}

/* Lista suggerimenti ticker */
QListView#symbolPopup {
    background-color: @surface;
    border: 1px solid @border;
    padding: 4px;
    outline: none;
}
QListView#symbolPopup::item {
    padding: 8px;
    border-radius: 4px;
}
QListView#symbolPopup::item:selected, QListView#symbolPopup::item:hover {
    background-color: @accent;
    color: @accent_text;
}
