# Installazione:
#   sudo cp deploy/pytrader.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now pytrader
#   journalctl -u pytrader -f
[Unit]
Description=PyTrader - Donchian/VWAP crypto trading bot
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/PyTrader
ExecStart=/home/pi/PyTrader/.venv/bin/python src/main.py
Restart=on-failure
RestartSec=30
KillSignal=SIGTERM
TimeoutStopSec=30
Nice=5

[Install]
WantedBy=multi-user.target
