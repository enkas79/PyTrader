# --- Exchange -------------------------------------------------------------
EXCHANGE_ID=binanceusdm          # id ccxt (binanceusdm, bybit, okx, ...)
SYMBOL=BTC/USDT:USDT             # perpetual lineare; per lo spot: BTC/USDT
API_KEY=
API_SECRET=
API_PASSWORD=                    # solo OKX/KuCoin
SANDBOX=false                    # testnet / demo trading
LEVERAGE=5                       # leva sul simbolo (> MAX_NOTIONAL_MULTIPLE)
MARGIN_MODE=isolated

# --- Strategia ------------------------------------------------------------
TIMEFRAME=15m
ATR_LENGTH=14
DONCHIAN_LENGTH=55
VWAP_BAND_STD=2.0
SL_ATR_MULT=2.0
TP_ATR_MULT=5.0
OHLCV_LIMIT=300
ALLOW_SHORT=true                 # false obbligatorio sullo spot

# --- Rischio --------------------------------------------------------------
RISK_PER_TRADE=0.01              # 1% del capitale per trade
MAX_NOTIONAL_MULTIPLE=3.0        # tetto nozionale = 3x saldo (<=1 sullo spot)

# --- Runtime --------------------------------------------------------------
DRY_RUN=true                     # paper trading con dati reali
PAPER_BALANCE=10000
EXCHANGE_STOPS=true              # SL/TP reduce-only sull'exchange (false sullo spot)
EXIT_POLL_SECONDS=10             # polling uscite software (paper/spot)
CANDLE_CLOSE_DELAY=5             # secondi dopo la chiusura candela
LOG_LEVEL=INFO
# DB_PATH=/home/pi/PyTrader/data/pytrader.sqlite3
# LOG_PATH=/home/pi/PyTrader/logs/pytrader.log
